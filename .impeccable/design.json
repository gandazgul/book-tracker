  "components": [
    {
      "name": "Text action",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Quiet berry action used in panel headings.",
      "html": "<button class=\"ds-text\">View library <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-text{font-family:var(--font-sans,'Manrope Variable',sans-serif);font-size:14px;line-height:1.55;color:var(--color-berry,#814664);background:none;border:0;padding:2px 0;display:inline-flex;align-items:center;gap:8px;cursor:pointer;transition:color 160ms ease-out,background-color 160ms ease-out}.ds-text:hover{color:#512840;text-decoration:underline}.ds-text:focus-visible{outline:2px solid var(--color-berry,#814664);outline-offset:4px;}.ds-text:disabled{opacity:.55;cursor:wait}@media(prefers-reduced-motion:reduce){.ds-text{transition:none}}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Current section with a softly filled lilac state.",
      "html": "<nav aria-label=\"Preview navigation\"><button class=\"ds-nav\" aria-current=\"page\"><svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-8H9v8H4a1 1 0 0 1-1-1Z\"/></svg>Overview</button></nav>",
      "css": ".ds-nav{font-family:var(--font-sans,'Manrope Variable',sans-serif);font-size:14px;line-height:1.55;font-size:16px;font-weight:500;color:var(--color-ink,#2c2032);background:transparent;border:0;border-radius:6px;display:flex;align-items:center;gap:14px;padding:13px 14px;min-height:47px;width:100%;text-align:left;cursor:pointer;transition:color 160ms ease-out,background-color 160ms ease-out}.ds-nav:hover{background:#e5dbe9}.ds-nav[aria-current]{background:var(--active,#dfd1e2);color:#663451;font-weight:700}.ds-nav:focus-visible{outline:2px solid var(--color-berry,#814664);outline-offset:4px;}@media(max-width:1190px){.ds-nav{font-size:14px}}@media(max-width:700px){.ds-nav{font-size:13px;padding:9px 7px;min-height:40px}}@media(prefers-reduced-motion:reduce){.ds-nav{transition:none}}"
    },
    {
      "name": "Search field",
      "kind": "input",
      "refersTo": "input-search",
      "description": "Outlined search with a leading icon.",
      "html": "<label class=\"ds-search\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input aria-label=\"Search books\" type=\"search\" placeholder=\"Search title, author or series\"/></label>",
      "css": ".ds-search{position:relative;display:block;color:var(--muted,#6c6173)}.ds-search svg{position:absolute;left:14px;top:13px}.ds-search input{font-family:var(--font-sans,'Manrope Variable',sans-serif);font-size:14px;line-height:1.55;width:100%;min-height:42px;padding:9px 13px 9px 42px;border:1px solid #cfc4d6;border-radius:8px;background:transparent;color:var(--color-ink,#2c2032);caret-color:var(--color-berry,#814664)}.ds-search input::placeholder{color:var(--muted,#6c6173)}.ds-search input:focus-visible{outline:2px solid var(--color-berry,#814664);outline-offset:4px;}"
    },
    {
      "name": "Author filter",
      "kind": "chip",
      "refersTo": "filter-chip",
      "description": "Removable active filter; preview label is illustrative.",
      "html": "<button class=\"ds-filter\">Author filter <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-label=\"Clear author filter\"><path d=\"m6 6 12 12M18 6 6 18\"/></svg></button>",
      "css": ".ds-filter{font-family:var(--font-sans,'Manrope Variable',sans-serif);font-size:14px;line-height:1.55;display:inline-flex;gap:8px;align-items:center;background:#e8daea;border:0;padding:5px 9px;border-radius:5px;color:#6b4264;cursor:pointer;transition:color 160ms ease-out,background-color 160ms ease-out}.ds-filter:focus-visible{outline:2px solid var(--color-berry,#814664);outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-filter{transition:none}}"
