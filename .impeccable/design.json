    {
      "name": "Content panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Quiet flat container with a direct heading.",
      "html": "<section class=\"ds-panel\"><h2>Recently finished</h2><p>Books from your reading history.</p></section>",
      "css": ".ds-panel{font-family:var(--font-sans,'Manrope Variable',sans-serif);font-size:14px;line-height:1.55;color:var(--color-ink,#2c2032);background:var(--surface,#fdfcfe);border-radius:12px;padding:22px 24px 24px}.ds-panel h2{font-size:18px;line-height:1.4;font-weight:750;letter-spacing:-.025em;margin:0 0 22px}.ds-panel p{margin:0;color:var(--muted,#6c6173)}@media(max-width:1190px){.ds-panel{padding:20px}}@media(max-width:700px){.ds-panel{padding:18px}.ds-panel h2{font-size:16px}}"
    },
    {
      "name": "Cover placeholder",
      "kind": "custom",
      "refersTo": "cover-placeholder",
