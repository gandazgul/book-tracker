---
import Dashboard from '../components/Dashboard';
import '@fontsource-variable/literata';
import '@fontsource-variable/manrope';
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Your reading, at a glance. A personal reading dashboard connected to your Google Sheet." />
    <meta name="theme-color" content="#eeE8f1" />
    <link rel="icon" type="image/svg+xml" sizes="any" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <title>Between the Lines · Your reading dashboard</title>
  </head>
  <body>
    <Dashboard client:load />
    <noscript><p>This dashboard needs JavaScript to read your Google Sheet. <a href="https://docs.google.com/spreadsheets/d/11e9H7MEYZdOWZlKPdGITu-bvmHbw4N5szeoqd1Ordmk/edit">Open your reading sheet</a>.</p></noscript>
  </body>
</html>
